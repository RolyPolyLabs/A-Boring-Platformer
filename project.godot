;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="A Boring Platformer"
run/main_scene="uid://cjx6wv7xkgoaa"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

SignalBus="*uid://co8pgufi1vism"
BgMusic="*uid://cswu15nflrfy6"
Bgmenumusic="*uid://dwmgtqxsrkflb"
PauseMenu="*uid://dhhh84m5q4ob1"
AppConfig="*uid://cjke6crjg14a0"
InputFinder="*uid://e0n4v6jn3akp"

[display]

window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_super-wakatime/plugin.cfg", "res://addons/godot_test_scene/plugin.cfg", "res://addons/maaacks_input_remapping/plugin.cfg")

